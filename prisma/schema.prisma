generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  iconName  String?
  campaigns Campaign[]
  createdAt DateTime   @default(now())
}

model Campaign {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  targetAmount    Float?
  collectedAmount Float            @default(0)
  donorCount      Int              @default(0)
  endDate         DateTime?
  isUrgent        Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  location        String?
  excerpt         String?
  story           String
  bannerUrl       String?
  status          String           @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  updates         CampaignUpdate[]
  donations       Donation[]
  routineDonations RoutineDonation[]

  @@index([categoryId])
  @@index([isUrgent])
  @@index([isFeatured])
  @@index([status])
  @@index([status, createdAt(sort: Desc)])
}

model CampaignUpdate {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title           String
  content         String
  disbursedAmount Float    @default(0)
  approvalStatus  String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  date            DateTime @default(now())
  images          String[] @default([])
  createdAt       DateTime @default(now())

  @@index([campaignId])
}

model Donation {
  id             String    @id @default(cuid())
  invoiceId      String    @unique
  accessToken    String?   @unique
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  donationType   String    @default("CAMPAIGN") // CAMPAIGN, ZAKAT, INFAK_SUBUH, WAKAF
  amount         Float
  uniqueCode     Int       @default(0)
  totalAmount    Float
  paymentChannel String // QRIS, BCA_VA, MANDIRI_VA, BSI_VA, BRI_VA
  paymentRef     String?
  donorName      String
  donorEmail     String?
  donorPhone     String
  donorAvatar    String?
  isAnonymous    Boolean   @default(false)
  prayer         String?
  aminCount      Int       @default(0)
  isPrayerHidden Boolean   @default(false)
  isPrayerPinned Boolean   @default(false)
  prayerReply    String?
  prayerReplyAt  DateTime?
  status         String    @default("PENDING") // PENDING, PAID, EXPIRED, CANCELLED
  paidAt         DateTime?
  expiredAt      DateTime
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([donorEmail])
  @@index([donorPhone])
  @@index([campaignId])
  @@index([status])
  @@index([status, paidAt(sort: Desc)])
  @@index([campaignId, status, paidAt(sort: Desc)])
}

model AuditReport {
  id               String   @id @default(cuid())
  year             Int
  title            String
  auditorName      String
  opinionStatus    String   @default("WTP") // Wajar Tanpa Pengecualian
  totalFundsIn     Float
  totalFundsOut    Float
  beneficiaryCount Int
  operationalRatio String?
  summary          String?
  pdfUrl           String?
  publishedAt      DateTime @default(now())

  @@index([year(sort: Desc)])
}

model Volunteer {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  phone      String
  city       String
  interest   String
  motivation String
  status     String   @default("PENDING") // PENDING, APPROVED, CONTACTED
  createdAt  DateTime @default(now())

  @@index([status])
}

model Article {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  categories     String[] @default([])
  tags           String[] @default([])
  excerpt        String
  content        String
  author         String
  bannerUrl      String?
  imageSource    String?
  imageSourceUrl String?
  likeCount      Int      @default(0)
  dislikeCount   Int      @default(0)
  publishedAt    DateTime @default(now())

  @@index([category])
  @@index([publishedAt(sort: Desc)])
  @@index([category, publishedAt(sort: Desc)])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String?  @unique
  passwordHash String?
  phone        String?
  role            String   @default("DONOR") // SUPER_ADMIN, ADMIN, FINANCE, VOLUNTEER, DONOR
  title           String?  @default("Donatur Terdaftar")
  salutation      String?  @default("Bpk.")
  bio             String?
  city            String?
  address         String?
  coverImage      String?
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  avatar          String?
  provider        String   @default("CREDENTIALS") // CREDENTIALS, GOOGLE, FACEBOOK
  providerId      String?
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model InstagramPost {
  id           String   @id @default(cuid())
  caption      String
  imageUrl     String
  altText      String?
  postUrl      String   @default("https://www.instagram.com")
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  postedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([postedAt])
}

model RoutineDonation {
  id           String    @id @default(cuid())
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  programTitle String
  amount       Float
  frequency    String    @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  routineType  String    @default("AUTO_DONATION") // REMINDER_ONLY, AUTO_DONATION
  status       String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  selectedDay  String?
  monthlyDate  DateTime?
  reminderTime String?   @default("05:00")
  donorName    String
  donorEmail   String?
  donorPhone   String
  isAnonymous  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([donorEmail])
  @@index([donorName])
  @@index([status])
  @@index([campaignId])
}

model JobVacancy {
  id               String           @id @default(cuid())
  jobCode          String           @unique
  title            String
  department       String
  location         String
  type             String           @default("Penuh Waktu (Full-time)")
  workplace        String           @default("On-site")
  experience       String           @default("1 - 3 tahun")
  publishedDate    String
  deadline         String
  overview         String
  responsibilities String[]         @default([])
  requirements     String[]         @default([])
  benefits         String[]         @default([])
  applyUrl         String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]

  @@index([department])
  @@index([location])
  @@index([isActive])
  @@index([isActive, createdAt(sort: Desc)])
}

model JobApplication {
  id           String     @id @default(cuid())
  vacancyId    String
  vacancy      JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String
  linkedinUrl  String?
  portfolioUrl String?
  coverLetter  String
  resumeUrl    String?
  status       String     @default("PENDING") // PENDING, REVIEWED, SHORTLISTED, REJECTED
  createdAt    DateTime   @default(now())

  @@index([vacancyId])
  @@index([email])
  @@index([status])
}

model Beneficiary {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. YTM-001, DHF-001
  name      String
  gender    String   // L, P
  category  String   // YATIM, LANSIA_DHUAFA
  program   String
  location  String
  createdAt DateTime @default(now())

  @@index([category])
  @@index([gender])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("Umum")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model OrgSetting {
  id           String   @id @default("org_profile")
  name         String
  shortName    String
  tagline      String?
  legalSk      String?
  npwp         String?
  izinSosial   String?
  address      String?
  phone        String?
  whatsapp     String?
  email        String?
  officeHours  String?
  bankAccounts Json?
  vision       String?
  missions     String[] @default([])
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userRole    String?
  action      String
  targetType  String?
  targetId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
