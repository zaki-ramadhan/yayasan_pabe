# Database URL (PostgreSQL - Supabase / Neon / Local VPS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/db_yayasan_gsm?schema=public"

# App URL (Ganti dengan domain asli saat production, e.g. https://yayasanpabe.org)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Midtrans / Payment Gateway Server Key (Optional/Future)
PAYMENT_SERVER_KEY=""
PAYMENT_CLIENT_KEY=""

# Facebook Auth
NEXT_PUBLIC_FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Instagram Feed API
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# Super Admin Emails (comma-separated list, server-side only)
SUPER_ADMIN_EMAILS="superadmin@pabe.or.id"

# Vercel Cron Secret (Optional, for protecting /api/cron/routine-donations)
CRON_SECRET="your_secure_cron_secret_token"

# WhatsApp Messaging Gateway (Driver: mock, meta, fonnte)
WA_DRIVER="mock"
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
FONNTE_TOKEN=""
