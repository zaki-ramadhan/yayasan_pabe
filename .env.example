# Database URL (PostgreSQL - Supabase / Neon / Local VPS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/db_yayasan_gsm?schema=public"

# App URL (Ganti dengan domain asli saat production, e.g. https://yayasanpabe.org)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Keamanan Sesi Kriptografis (HMAC-SHA256 Anti-Forgery)
SESSION_SECRET="your_secure_random_64_char_session_secret"

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Cloudflare R2 Object Storage (Media, Banner, CV, LPJ & Database Backups)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ypabe-storage"
R2_PUBLIC_URL="https://pub-d695853be49c485484cd7799dc192352.r2.dev"

# Facebook Auth
NEXT_PUBLIC_FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Instagram Feed API
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# Super Admin Emails (comma-separated list, server-side only)
SUPER_ADMIN_EMAILS=""

# Cron Secret (Melindungi rute /api/cron/routine-donations & /api/cron/expire-donations)
CRON_SECRET="your_secure_cron_secret_token"

# Email Service (Dual-Provider: Resend [100/hari] + Brevo Fallback [300/hari] -> Total 400 email/hari gratis)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Yayasan Payung Berkah <noreply@pabe.or.id>"
BREVO_API_KEY=""
BREVO_FROM_EMAIL="Yayasan Payung Berkah <noreply@pabe.or.id>"
EMAIL_LOGO_URL=""
